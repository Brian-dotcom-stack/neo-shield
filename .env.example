# GEMINI_API_KEY: Optional for AI-assisted security insights
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The public domain where this applet or SaaS is hosted.
# Used for Stripe redirect callbacks (checkout & customer portal) and OAuth.
APP_URL="http://localhost:3000"

# SUPABASE CONFIGURATION
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# STRIPE CONFIGURATION
# Obtain these from your Stripe Dashboard -> Developers -> API keys & Webhooks
STRIPE_SECRET_KEY="sk_test_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# STRIPE PRICE IDS (Monthly & Yearly for Basic, Pro, Family)
STRIPE_PRICE_BASIC_MONTHLY="price_basic_monthly_id"
STRIPE_PRICE_BASIC_YEARLY="price_basic_yearly_id"
STRIPE_PRICE_PRO_MONTHLY="price_pro_monthly_id"
STRIPE_PRICE_PRO_YEARLY="price_pro_yearly_id"
STRIPE_PRICE_FAMILY_MONTHLY="price_family_monthly_id"
STRIPE_PRICE_FAMILY_YEARLY="price_family_yearly_id"
